<UserControl x:Class="Tour.Views.TourOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             IsHitTestVisible="True">
    <UserControl.Resources>
        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3333FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2222CC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                                <Setter Property="Foreground" Value="LightGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fade In Animation -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.7"
                             FillBehavior="HoldEnd"/>
        </Storyboard>

        <!-- Fade Out Animation -->
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.3"
                             FillBehavior="HoldEnd"/>
        </Storyboard>
    </UserControl.Resources>
    <Grid x:Name="DarkOverlayy"
      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
      Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
      IsHitTestVisible="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="0*"/>
        </Grid.ColumnDefinitions>

        <!-- Black background with 70% opacity -->
        <Grid.Background>
            <SolidColorBrush Color="Black" Opacity="0.7"/>
        </Grid.Background>

        <!-- Geometry-based mask -->
        <Grid.OpacityMask>
            <DrawingBrush x:Name="OverlayMaskBrush" />
        </Grid.OpacityMask>

        <Canvas Grid.ColumnSpan="3">
            <!-- Highlight glow -->
            <Grid x:Name="HighlightElementBorder" >
                <Border BorderBrush="Yellow" BorderThickness="3" Panel.ZIndex="2"/>
            </Grid>

            <!-- Tooltip panel -->
            <Border x:Name="TooltipPanelBorder" Width="250" Background="White" Padding="10" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TourStepTitle" FontSize="14" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TourStepDescription" FontSize="14" Foreground="Black" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="PrevBtn" Content="Previous" Margin="0,0,10,0" Style="{StaticResource RoundedButtonStyle}"/>
                        <Button x:Name="NextBtn" Content="Next" Style="{StaticResource RoundedButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>

</UserControl>
